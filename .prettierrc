{
    "tabWidth": 4,
    "useTabs": false,
    "plugins": [
        "prettier-plugin-svelte",
        "@trivago/prettier-plugin-sort-imports"
    ],
    "overrides": [
        {
            "files": "*.svelte",
            "options": {
                "parser": "svelte"
            }
        }
    ]
}
